{
  "name": "@tvsm/management",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k -n api,web \"pnpm dev:api\" \"pnpm dev:web\"",
    "dev:api": "TVSM_PORT=8081 tsx watch server/main.ts",
    "dev:web": "vite",
    "build": "vite build && node build-server.mjs",
    "typecheck": "tsc -p tsconfig.json",
    "test": "TVSM_LOG_LEVEL=warn node --import tsx --test test/*.test.ts"
  },
  "dependencies": {
    "@tvsm/platform": "workspace:*",
    "@tvsm/ui": "workspace:*",
    "atem-connection": "^3.10.3",
    "casparcg-connection": "^7.0.0",
    "fastify": "^5.6.1",
    "lucide-react": "^0.548.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "react-i18next": "^16.2.0",
    "react-router-dom": "^7.9.4",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.1.16",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitejs/plugin-react": "^5.1.0",
    "concurrently": "^9.2.1",
    "esbuild": "^0.25.11",
    "tailwindcss": "^4.1.16",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3",
    "vite": "^7.1.12"
  }
}
