<!-- WinSW service definition for the TV Station Manager node agent. -->
<service>
  <id>tvsm-agent</id>
  <name>TV Station Manager agent</name>
  <description>Connects this node to the TV Station Manager orchestrator.</description>
  <executable>%BASE%\node.exe</executable>
  <arguments>--disable-warning=ExperimentalWarning "%BASE%\agent.mjs" run</arguments>
  <startmode>Automatic</startmode>
  <delayedAutoStart>true</delayedAutoStart>
  <onfailure action="restart" delay="5 sec" />
  <onfailure action="restart" delay="10 sec" />
  <resetfailure>1 hour</resetfailure>
  <log mode="roll-by-size">
    <sizeThreshold>10240</sizeThreshold>
    <keepFiles>5</keepFiles>
  </log>
  <logpath>%ProgramData%\TVSM\agent\logs</logpath>
</service>
